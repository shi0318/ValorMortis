---
// Full-game countdown — Demo is playable now, full game lands on the stored release date.
import { SITE, isReleased } from '../data/site';
import { formatReleaseDate } from '../utils/release-date.js';

const released = isReleased();
const releaseDate = formatReleaseDate(SITE.releaseDate);
---

{
  released ? (
    <div class="inline-flex items-center gap-2 rounded-2xl border border-spectral/30 bg-spectral/10 px-5 py-3 text-sm font-semibold text-spectral backdrop-blur-md">
      <span class="h-2 w-2 rounded-full bg-spectral" />
      Full game out now — verified guides live
    </div>
  ) : (
    <div
      class="inline-flex min-w-[11rem] flex-col items-center rounded-2xl border border-white/12 bg-black/45 px-5 py-4 text-center shadow-[0_12px_40px_rgba(0,0,0,0.4)] backdrop-blur-md"
      data-countdown
      data-release={SITE.releaseDate}
    >
      <span class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-fog" data-countdown-prefix>Full game in</span>
      <span class="mt-1 text-4xl font-black tabular-nums tracking-tight text-brass-bright" data-countdown-value aria-live="polite">
        --
      </span>
      <span class="mt-1 text-xs text-fog">
        <span data-countdown-suffix>days</span> · <time datetime={SITE.releaseDate}>{releaseDate}</time>
      </span>
    </div>
  )
}

<script>
  import { getReleaseState } from '../utils/release-date.js';

  const el = document.querySelector<HTMLElement>('[data-countdown]');
  if (el) {
    const out = el.querySelector<HTMLElement>('[data-countdown-value]');
    const prefix = el.querySelector<HTMLElement>('[data-countdown-prefix]');
    const suffix = el.querySelector<HTMLElement>('[data-countdown-suffix]');
    const tick = () => {
      const release = el.dataset.release;
      if (!release) return;
      const state = getReleaseState(release);
      if (state.kind === 'released') {
        if (prefix) prefix.textContent = '';
        if (out) out.textContent = 'Full game out now';
        if (suffix) suffix.textContent = '';
        return;
      }
      if (state.kind === 'today') {
        if (prefix) prefix.textContent = '';
        if (out) out.textContent = 'Launches today';
        if (suffix) suffix.textContent = '';
        return;
      }
      if (prefix) prefix.textContent = 'Full game in';
      if (out) out.textContent = String(state.days);
      if (suffix) suffix.textContent = state.days === 1 ? 'day' : 'days';
    };
    tick();
    setInterval(tick, 60000);
  }
</script>
