---
import { NAV, SITE } from '../data/site';
import { CORE_SOURCES } from '../data/sources';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-crypt">
  <div class="container py-12">
    <div class="grid gap-8 md:grid-cols-[1.25fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-md border border-blood/40 bg-blood/10 text-sm font-black text-blood-bright">
            VM
          </span>
          <div>
            <p class="text-sm font-black uppercase text-bone">{SITE.name}</p>
            <p class="text-xs font-semibold uppercase text-fog">{SITE.tagline}</p>
          </div>
        </div>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-fog">
          Independent guidance for the released {SITE.gameName}, with clearly separated historical Demo material.
        </p>
      </div>

      <nav aria-label="Guide links">
        <p class="text-xs font-black uppercase text-bone">Explore</p>
        <ul class="mt-3 space-y-2">
          {NAV.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-fog hover:text-blood-bright">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Official links">
        <p class="text-xs font-black uppercase text-bone">Official sources</p>
        <ul class="mt-3 space-y-2">
          {CORE_SOURCES.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="nofollow noopener noreferrer" class="text-sm text-fog hover:text-blood-bright">
                {source.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-xs leading-relaxed text-smoke">
      <p>
        Unofficial fan guide. Not affiliated with One More Level or Lyrical Games. Valor Mortis, screenshots, names, and trademarks belong to their respective owners.
      </p>
      <p class="mt-2">
        Corrections and enquiries:
        <a href={`mailto:${SITE.contactEmail}`} class="text-brass-bright underline underline-offset-2">{SITE.contactEmail}</a>.
      </p>
      <nav aria-label="Site policies" class="mt-4 flex flex-wrap gap-4">{["about", "contact", "privacy", "terms", "editorial"].map(path => <a href={`/${path}/`} class="underline">{path === "privacy" ? "Privacy policy" : path === "editorial" ? "Editorial policy" : path === "terms" ? "Terms of use" : path}</a>)}</nav>
      <p class="mt-2">&copy; {year} {SITE.name}.</p>
    </div>
  </div>
</footer>
