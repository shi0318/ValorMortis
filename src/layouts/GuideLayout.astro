---
// Guide article layout — each markdown file in src/content/guides/ renders through this.
// Breadcrumb → Demo notice → H1 → body → source table.
import Layout from './Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import DemoNotice from '../components/DemoNotice.astro';
import StatusBadge from '../components/StatusBadge.astro';
import SourcePanel from '../components/SourcePanel.astro';
import { STATUS_META, INDEXABLE_STATUS, type ConfidenceStatus } from '../data/confidence';
import { SOURCES, type SourceRef, type SourceKey } from '../data/sources';

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  heading?: string;
  description: string;
  category: 'guide' | 'walkthrough' | 'boss' | 'weapons' | 'skills' | 'settings' | 'secrets' | 'news';
  status: ConfidenceStatus;
  sourceKeys?: SourceKey[];
  demoNotice?: boolean;
  updatedAt: string;
}

const {
  title,
  heading,
  description,
  status,
  sourceKeys = [],
  demoNotice = true,
  updatedAt,
} = Astro.props;

const SEGMENT_LABEL: Record<string, string> = {
  demo: 'Demo',
  guide: 'Guide',
  walkthrough: 'Walkthrough',
  'boss-guide': 'Boss Guide',
  'weapons-and-abilities': 'Weapons & Abilities',
  'skill-tree': 'Skill Tree',
  'settings-and-known-issues': 'Settings & Known Issues',
  'secrets-and-speedrun': 'Secrets & Speedrun',
  news: 'News',
};

const h1 = heading ?? title;
const titleize = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const segments = Astro.url.pathname.split('/').filter(Boolean);
const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  ...segments.map((seg, i) => {
    const url = '/' + segments.slice(0, i + 1).join('/') + '/';
    const name = i === segments.length - 1 ? h1 : (SEGMENT_LABEL[seg] ?? titleize(seg));
    return { name, url };
  }),
];

const meta = STATUS_META[status];
const noindex = !INDEXABLE_STATUS.includes(status);
const sources: SourceRef[] = sourceKeys.map((k) => SOURCES[k]);
---

<Layout
  title={title}
  description={description}
  pageType="article"
  breadcrumbs={crumbs}
  noindex={noindex}
>
  <article class="container max-w-3xl py-10">
    <Breadcrumb items={crumbs} />

    {demoNotice && <div class="mt-4"><DemoNotice /></div>}

    <header class="mt-6 border-b border-white/10 pb-6">
      <div class="mb-3">
        <StatusBadge status={status} />
      </div>
      <h1 class="text-3xl font-black tracking-tight text-parchment md:text-4xl">{h1}</h1>
      <p class="mt-3 text-lg text-fog">{description}</p>
      <p class="mt-4 text-sm text-smoke">
        Last verified <time datetime={updatedAt}>{updatedAt}</time> · {meta.label}
      </p>
    </header>

    <div class="prose-page mt-8">
      <slot />
    </div>

    <SourcePanel sources={sources} />
  </article>
</Layout>
