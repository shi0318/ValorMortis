---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AmbientParticles from '../components/AmbientParticles.astro';
import { ASSETS } from '../data/assets';
import { SITE } from '../data/site';

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  pageType?: 'home' | 'article' | 'collection' | 'page';
  canonical?: string;
  image?: string;
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  fullWidth?: boolean;
  updatedAt?: string;
  faqs?: { question: string; answer: string }[];
}

const {
  title,
  description,
  pageType = 'article',
  canonical,
  image = ASSETS.hero.src,
  breadcrumbs = [],
  noindex = false,
  fullWidth = false,
  updatedAt,
  faqs = [],
} = Astro.props;

const path = Astro.url.pathname;
const isErrorPage = path.includes('404');
const canonicalUrl = isErrorPage || noindex ? undefined : (canonical ?? new URL(path, SITE.url).href);
const imageUrl = new URL(image, SITE.url).href;
// Inactive configuration retained for a future consent-gated restoration.
const pausedGA4 = 'G-STS9CDRXE6';

const organization = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name + ' editorial team',
  description: 'Unofficial fan guide. Not affiliated with One More Level or Lyrical Games.',
  url: `${SITE.url}/`,
  logo: {
    '@type': 'ImageObject',
    '@id': `${SITE.url}/#logo`,
    url: `${SITE.url}/logo-512.png`,
    width: 512,
    height: 512,
    caption: SITE.name,
  },
};

const videoGame = {
  '@type': 'VideoGame',
  name: SITE.gameName,
  applicationCategory: 'Game',
  genre: ['Action', 'Adventure', 'RPG'],
  gamePlatform: SITE.platforms,
  author: { '@type': 'Organization', name: SITE.developer },
  publisher: { '@type': 'Organization', name: SITE.publisher },
  datePublished: SITE.releaseDate,
};

const graph: Record<string, unknown>[] = [organization];

if (pageType === 'home') {
  graph.push({
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: `${SITE.url}/`,
    description: SITE.description,
    inLanguage: 'en',
    publisher: { '@id': `${SITE.url}/#organization` },
    about: videoGame,
  });
} else if (canonicalUrl) {
  graph.push({
    '@type': pageType === 'collection' ? 'CollectionPage' : pageType === 'page' ? 'WebPage' : 'Article',
    '@id': `${canonicalUrl}#${pageType}`,
    name: title,
    headline: title,
    description,
    url: canonicalUrl,
    inLanguage: 'en',
    image: [imageUrl],
    isPartOf: { '@id': `${SITE.url}/#website` },
    publisher: { '@id': `${SITE.url}/#organization` },
    author: { '@id': `${SITE.url}/#organization` },
    ...(updatedAt ? { dateModified: updatedAt } : {}),
  });
}

if (breadcrumbs.length > 0 && canonicalUrl) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.url, SITE.url).href,
    })),
  });
}

if (faqs.length > 0 && canonicalUrl) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqs.map(faq => ({
      '@type': 'Question', name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}
const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {(noindex || isErrorPage) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={pageType === 'home' ? 'website' : 'article'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="application-name" content={SITE.name} />
    <meta name="theme-color" content="#0b0d0f" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  </head>
  <body class="flex min-h-screen flex-col">
    <AmbientParticles />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brass focus:px-4 focus:py-2 focus:text-void">
      Skip to content
    </a>
    <Header />
    <main id="main" class:list={['flex-1', fullWidth ? '' : 'container py-10']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
