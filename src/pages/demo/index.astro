---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getCollection } from 'astro:content';
const ids = ["demo/walkthrough"];
const guides = (await getCollection('guides')).filter(g => ids.includes(g.id));
---
<Layout title="Valor Mortis Demo archive" description="Choose a focused Valor Mortis reference for combat, exploration, installation and historical Demo questions, with clear limits on untested claims." pageType="collection">
<div class="container py-10"><h1 class="section-title">Valor Mortis Demo archive</h1><p class="mt-4 text-fog">Choose the question you need to answer. Retail guides describe the released game; the separate Demo reference records historical announcements and app boundaries.</p><ul class="mt-8 grid gap-5 md:grid-cols-2">{guides.map(g => <li><a class="text-brass-bright underline" href={'/' + g.id + '/'}>{g.data.heading ?? g.data.title}</a><p class="text-fog">{g.data.description}</p></li>)}</ul><p class="mt-8"><a href="/guides/">Retail guides</a> · <a href="/demo/">Demo archive</a> · <a href="/download/">Official installation options</a></p></div>
</Layout>
