---
// Demo guide hub — CollectionPage aggregating every Demo guide page.
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getCollection } from 'astro:content';
import { ASSETS } from '../../data/assets';
import { SITE } from '../../data/site';

const title = 'Valor Mortis Demo Guide — Every Page, Source-Tracked';
const description =
  'Browse every Valor Mortis Demo guide: walkthrough, boss tactics, weapons and abilities, and PC settings — each page tagged with where its facts come from.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Demo Guide', url: '/demo/' },
];

const CATEGORY_LABEL: Record<string, string> = {
  guide: 'Overview',
  walkthrough: 'Walkthrough',
  boss: 'Boss Guide',
  weapons: 'Weapons & Abilities',
  skills: 'Skill Tree',
  settings: 'Settings',
  secrets: 'Secrets & Speedrun',
  news: 'News',
};

const FALLBACK_COVER: Record<string, string> = {
  guide: ASSETS.parisNightmare.src,
  walkthrough: ASSETS.parisNightmare.src,
  boss: ASSETS.bossFight.src,
  weapons: ASSETS.rapierCombat.src,
  skills: ASSETS.spectralPower.src,
  settings: ASSETS.decayingBoulevard.src,
  secrets: ASSETS.catacombs.src,
  news: ASSETS.hero.src,
};

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

function coverOf(g: (typeof guides)[number]) {
  return g.data.cover ?? FALLBACK_COVER[g.data.category] ?? ASSETS.hero.src;
}
---

<Layout title={title} description={description} pageType="collection" breadcrumbs={crumbs}>
  <div class="container py-10">
    <Breadcrumb items={crumbs} />

    <header class="mt-6 max-w-3xl">
      <p class="section-kicker">Start here</p>
      <h1 class="section-title">Every Valor Mortis Demo guide</h1>
      <p class="mt-3 text-lg text-fog">
        The free {SITE.gameName} Demo is playable now on Steam. Every card below shows a confirmation
        status so you can tell official Steam facts from clearly-labelled inference.
      </p>
    </header>

    <div class="mt-8"><DemoNotice /></div>

    {
      guides.length > 0 && (
        <section class="mt-10" aria-label="All Demo guides">
          <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {guides.map((g) => (
              <li>
                <a href={`/${g.id}/`} class="surface group flex h-full flex-col overflow-hidden">
                  <div class="aspect-[16/10] overflow-hidden bg-ash">
                    <img
                      src={coverOf(g)}
                      alt={`${g.data.heading ?? g.data.title} cover`}
                      width="640"
                      height="400"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                    />
                  </div>
                  <div class="flex flex-1 flex-col p-4">
                    <div class="mb-2 flex items-center justify-between gap-2">
                      <span class="text-[11px] font-black uppercase tracking-[0.12em] text-brass-bright">
                        {CATEGORY_LABEL[g.data.category] ?? g.data.category}
                      </span>
                      <StatusBadge status={g.data.status} size="sm" />
                    </div>
                    <h2 class="text-base font-black text-bone group-hover:text-brass-bright md:text-lg">
                      {g.data.heading ?? g.data.title}
                    </h2>
                    <p class="mt-2 flex-1 text-sm leading-relaxed text-fog">{g.data.description}</p>
                    <span class="mt-4 text-sm font-bold text-brass-bright">Read →</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Layout>
