---
// Demo guide hub — CollectionPage aggregating every Demo guide page.
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import GuideCard from '../../components/GuideCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { ASSETS } from '../../data/assets';
import { SITE } from '../../data/site';

const title = 'Valor Mortis Demo Guides — Every Page, Source-Tracked';
const description =
  'Browse every Valor Mortis Demo guide: walkthrough, boss tactics, weapons and abilities, and PC settings — each page tagged with where its facts come from.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Demo Guide', url: '/demo/' },
];

const CATEGORY_LABEL: Record<string, string> = {
  guide: 'Overview',
  walkthrough: 'Walkthrough',
  boss: 'Boss Guide',
  weapons: 'Weapons & Abilities',
  skills: 'Skill Tree',
  settings: 'Settings',
  secrets: 'Secrets & Speedrun',
  news: 'News',
};

const FALLBACK_COVER: Record<string, string> = {
  guide: ASSETS.parisNightmare.src,
  walkthrough: ASSETS.parisNightmare.src,
  boss: ASSETS.bossFight.src,
  weapons: ASSETS.rapierCombat.src,
  skills: ASSETS.spectralPower.src,
  settings: ASSETS.decayingBoulevard.src,
  secrets: ASSETS.catacombs.src,
  news: ASSETS.hero.src,
};

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updatedAt.localeCompare(a.data.updatedAt) || a.id.localeCompare(b.id),
);
const PAGE_SIZE = 9;
const currentPage = 1;
const totalPages = Math.ceil(guides.length / PAGE_SIZE);
const visibleGuides = guides.slice(0, PAGE_SIZE);

function coverOf(g: (typeof guides)[number]) {
  return g.data.cover ?? FALLBACK_COVER[g.data.category] ?? ASSETS.hero.src;
}
---

<Layout title={title} description={description} pageType="collection" breadcrumbs={crumbs}>
  <div class="container py-10">
    <Breadcrumb items={crumbs} />

    <header class="mt-6 max-w-3xl">
      <p class="section-kicker">Start here</p>
      <h1 class="section-title">Every Valor Mortis Demo guide</h1>
      <p class="mt-3 text-lg text-fog">
        The free {SITE.gameName} Demo is playable now on Steam. Every card below shows a confirmation
        status so you can tell official Steam facts from clearly-labelled inference.
      </p>
    </header>

    <div class="mt-8"><DemoNotice /></div>

    <section class="latest-guides mt-10" aria-label="Latest Demo guides">
      <p class="section-kicker">Latest guides first</p>
      <h2 class="mt-2 mb-5 text-2xl font-black text-bone">New and recently updated</h2>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {visibleGuides.map((g) => <GuideCard href={`/${g.id}/`} title={g.data.heading ?? g.data.title} description={g.data.description} cover={coverOf(g)} label={CATEGORY_LABEL[g.data.category] ?? g.data.category} status={g.data.status} />)}
      </ul>
      <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/demo/" />
    </section>
  </div>
</Layout>
