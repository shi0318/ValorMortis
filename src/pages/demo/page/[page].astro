---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import DemoNotice from '../../../components/DemoNotice.astro';
import GuideCard from '../../../components/GuideCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { ASSETS } from '../../../data/assets';

const PAGE_SIZE = 9;
const title = `Valor Mortis Demo Guides — Page ${Astro.params.page}`;
const description = 'More Valor Mortis Demo guides, sorted by the latest verified update date.';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Demo Guide', url: '/demo/' }, { name: `Page ${Astro.params.page}`, url: `/demo/page/${Astro.params.page}/` }];
const CATEGORY_LABEL: Record<string, string> = { guide: 'Overview', walkthrough: 'Walkthrough', boss: 'Boss Guide', weapons: 'Weapons & Abilities', skills: 'Skill Tree', settings: 'Settings', secrets: 'Secrets & Speedrun', news: 'News' };
const FALLBACK_COVER: Record<string, string> = { guide: ASSETS.parisNightmare.src, walkthrough: ASSETS.parisNightmare.src, boss: ASSETS.bossFight.src, weapons: ASSETS.rapierCombat.src, skills: ASSETS.spectralPower.src, settings: ASSETS.decayingBoulevard.src, secrets: ASSETS.catacombs.src, news: ASSETS.hero.src };

export async function getStaticPaths() {
  const PAGE_SIZE = 9;
  const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort((a, b) => b.data.updatedAt.localeCompare(a.data.updatedAt) || a.id.localeCompare(b.id));
  const totalPages = Math.ceil(guides.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => { const page = i + 2; return { params: { page: String(page) }, props: { guides, page, totalPages } }; });
}
const { guides, page, totalPages } = Astro.props;
const visibleGuides = guides.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
function coverOf(g: (typeof guides)[number]) { return g.data.cover ?? FALLBACK_COVER[g.data.category] ?? ASSETS.hero.src; }
---
<Layout title={title} description={description} pageType="collection" breadcrumbs={crumbs}>
  <div class="container py-10"><Breadcrumb items={crumbs} /><header class="mt-6 mb-8"><p class="section-kicker">Latest guides first</p><h1 class="section-title">Valor Mortis Demo guides — page {page}</h1><p class="mt-3 text-lg text-fog">Page {page} of {totalPages}; entries are sorted by their latest verified update.</p></header><div class="mb-8"><DemoNotice /></div><ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{visibleGuides.map((g) => <GuideCard href={`/${g.id}/`} title={g.data.heading ?? g.data.title} description={g.data.description} cover={coverOf(g)} label={CATEGORY_LABEL[g.data.category] ?? g.data.category} status={g.data.status} />)}</ul><Pagination currentPage={page} totalPages={totalPages} basePath="/demo/" /></div>
</Layout>
