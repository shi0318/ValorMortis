---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getCollection } from 'astro:content';
const ids = ["release-date", "download", "boss-achievement-and-chapter-recovery", "multi-enemy-positioning-threat-control", "rapier-saber-critical-combat-practice", "pc-stutter-after-halloween-update", "valor-mortis-october-21-hitbox-and-combat-guide", "how-to-beat-general-lothaire", "raphael-and-entity-endgame-boss-guide", "guides/achievements-and-trophies", "guides/windhover-achievement-guide", "guides/best-skills-guide", "guides/walkthrough"];
const guides = (await getCollection('guides')).filter(g => ids.includes(g.id));
---
<Layout title="Valor Mortis gameplay guides" description="Choose a focused Valor Mortis reference for combat, exploration, installation and historical Demo questions, with clear limits on untested claims." pageType="collection">
<div class="container py-10"><h1 class="section-title">Valor Mortis gameplay guides</h1><p class="mt-4 text-fog">Choose the question you need to answer. Retail guides describe the released game; the separate Demo reference records historical announcements and app boundaries.</p><h2 id="boss-guides" class="mt-8 section-title">Combat, progression and recovery references</h2><ul class="mt-8 grid gap-5 md:grid-cols-2">{guides.map(g => <li><a class="text-brass-bright underline" href={'/' + g.id + '/'}>{g.data.heading ?? g.data.title}</a><p class="text-fog">{g.data.description}</p></li>)}</ul><p class="mt-8"><a href="/guides/">Retail guides</a> · <a href="/demo/">Demo archive</a> · <a href="/download/">Official installation options</a></p></div>
</Layout>
