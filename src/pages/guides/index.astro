---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GuideCard from '../../components/GuideCard.astro';
import { ASSETS } from '../../data/assets';

const title = 'Valor Mortis Full-Game Guides — Achievements, Catalysts and Skills';
const description =
  'Retail Valor Mortis guides for achievements, Catalyst farming, skills, weapons, bosses, chapters, and every post-launch system.';
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Full-Game Guides', url: '/guides/' },
];
const CATEGORY_LABEL: Record<string, string> = {
  guide: 'Guide',
  walkthrough: 'Walkthrough',
  boss: 'Boss Guide',
  weapons: 'Weapons',
  skills: 'Skills',
  settings: 'Settings',
  secrets: 'Achievements & Secrets',
  news: 'News',
};
const FALLBACK_COVER: Record<string, string> = {
  guide: ASSETS.spectralPower.src,
  walkthrough: ASSETS.parisNightmare.src,
  boss: ASSETS.bossFight.src,
  weapons: ASSETS.rapierCombat.src,
  skills: ASSETS.parry.src,
  settings: ASSETS.decayingBoulevard.src,
  secrets: ASSETS.bossFight.src,
  news: ASSETS.hero.src,
};

const guides = (await getCollection('guides', ({ data }) => !data.draft && data.preRelease === false)).sort(
  (a, b) => b.data.updatedAt.localeCompare(a.data.updatedAt) || a.id.localeCompare(b.id),
);

function coverOf(g: (typeof guides)[number]) {
  return g.data.cover ?? FALLBACK_COVER[g.data.category] ?? ASSETS.hero.src;
}
---

<Layout title={title} description={description} pageType="collection" breadcrumbs={crumbs}>
  <div class="container py-10">
    <Breadcrumb items={crumbs} />

    <header class="mt-6 max-w-3xl">
      <p class="section-kicker">Retail guide hub</p>
      <h1 class="section-title">Valor Mortis full-game guides</h1>
      <p class="mt-3 text-lg text-fog">
        These pages cover the released PC game. They use retail chapter, boss, skill, weapon, Amber,
        and achievement data; the separate <a class="text-brass-bright underline" href="/demo/">Demo archive</a>
        remains available for the June build.
      </p>
    </header>

    <section class="mt-10" aria-label="Full-game guides">
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map((g) => (
          <GuideCard
            href={`/${g.id}/`}
            title={g.data.heading ?? g.data.title}
            description={g.data.description}
            cover={coverOf(g)}
            label={CATEGORY_LABEL[g.data.category] ?? g.data.category}
            status={g.data.status}
          />
        ))}
      </ul>
    </section>
  </div>
</Layout>
